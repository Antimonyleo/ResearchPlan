{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/rescamp/campaign.schema.json",
  "title": "ResCamp campaign state",
  "type": "object",
  "required": ["schema_version", "rescamp_version", "campaign_id", "goal_verbatim", "profile", "archetypes", "intent_dimensions", "interview", "campaign", "assurance", "reviews"],
  "properties": {
    "schema_version": {"const": "3.1"},
    "rescamp_version": {"type": "string"},
    "campaign_id": {"type": "string"},
    "goal_verbatim": {"type": "string"},
    "profile": {"enum": ["scoped", "standard", "high-assurance"]},
    "archetypes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "intent_dimensions": {"type": "array", "items": {"type": "object"}},
    "interview": {"type": "object"},
    "campaign": {
      "type": "object",
      "required": ["constitution", "mission", "dossier", "inquiries", "methods", "tools", "canaries", "evaluation", "stages", "gates", "resources_dispatch", "roles", "runtime", "work_units", "ethics_rights_safety", "reporting", "claims", "deliverables", "kickoff"]
    },
    "assurance": {
      "type": "object",
      "required": ["pilot_required", "pilot", "risk_acceptances"],
      "properties": {
        "pilot_required": {"type": "boolean"},
        "pilot": {
          "type": "object",
          "properties": {
            "status": {"enum": ["passed", "failed"]},
            "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "authorized_by": {"type": "string", "minLength": 1},
            "authority": {"type": "string", "minLength": 1},
            "executor_id": {"type": "string", "minLength": 1},
            "executed_at": {"type": "string", "minLength": 1},
            "scope": {"type": "string", "minLength": 1},
            "resource_cap": {"type": "string", "minLength": 1},
            "evidence": {"type": "array", "minItems": 1},
            "failures": {"type": "array"},
            "repairs": {"type": "array"}
          }
        },
        "risk_acceptances": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["finding_digest", "content_digest", "accepted_by", "authority", "accepted_at", "scope", "evidence"],
            "properties": {
              "finding_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "accepted_by": {"type": "string", "minLength": 1},
              "authority": {"type": "string", "minLength": 1},
              "accepted_at": {"type": "string", "minLength": 1},
              "scope": {"type": "string", "minLength": 1},
              "evidence": {"type": ["string", "array"]}
            }
          }
        }
      }
    },
    "reviews": {"type": "object"}
  }
}
