{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/rescamp/campaign.schema.json",
  "title": "ResCamp campaign state",
  "type": "object",
  "required": ["schema_version", "rescamp_version", "campaign_id", "goal_verbatim", "profile", "archetypes", "workflow", "sketch", "intent_dimensions", "interview", "campaign", "assurance", "reviews"],
  "properties": {
    "schema_version": {"const": "3.2"},
    "rescamp_version": {"type": "string"},
    "campaign_id": {"type": "string"},
    "goal_verbatim": {"type": "string"},
    "profile": {"enum": ["scoped", "standard", "high-assurance"]},
    "archetypes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "workflow": {
      "type": "object",
      "required": ["requested_mode", "artifact_level", "promotion"],
      "properties": {
        "requested_mode": {"enum": ["auto", "brief", "full"]},
        "artifact_level": {"enum": ["brief", "full"]},
        "promotion": {
          "type": "object",
          "required": ["status", "brief_digest", "answer_verbatim", "accepted_brief", "source", "offered_at", "decided_at"],
          "properties": {
            "status": {"enum": ["pending", "not-offered", "offered", "accepted", "declined", "not-applicable"]},
            "brief_digest": {"type": "string"},
            "answer_verbatim": {"type": "string"},
            "accepted_brief": {"type": "object"},
            "source": {"type": "string"},
            "offered_at": {"type": "string"},
            "decided_at": {"type": "string"}
          }
        }
      }
    },
    "sketch": {
      "type": "object",
      "required": ["decision_or_purpose", "scope", "non_goals", "core_inquiries", "likely_evidence", "rough_methods_stages", "success_or_adjudication", "assumptions_risks", "proposed_outputs", "next_action"],
      "properties": {
        "decision_or_purpose": {"type": "string"},
        "scope": {"type": "string"},
        "non_goals": {"type": "array", "items": {"type": "string"}},
        "core_inquiries": {"type": "array", "items": {"type": "string"}},
        "likely_evidence": {"type": "array", "items": {"type": "string"}},
        "rough_methods_stages": {"type": "array", "items": {"type": "string"}},
        "success_or_adjudication": {"type": "string"},
        "assumptions_risks": {"type": "array", "items": {"type": "string"}},
        "proposed_outputs": {"type": "array", "items": {"type": "string"}},
        "next_action": {"type": "string"}
      }
    },
    "intent_dimensions": {"type": "array", "items": {"type": "object"}},
    "interview": {"type": "object"},
    "campaign": {
      "type": "object",
      "properties": {
        "starting_point": {
          "type": "object",
          "required": ["entry_mode"],
          "properties": {
            "entry_mode": {"enum": ["new-project", "existing-project"]},
            "status_as_of": {"type": "string"},
            "status_summary": {"type": "string"},
            "assessment_basis": {"type": "array", "items": {"type": "string"}},
            "accepted_completed_work": {"type": "array", "items": {"type": "string"}},
            "work_in_progress": {"type": "array", "items": {"type": "string"}},
            "inherited_artifacts": {"type": "array", "items": {"type": "string"}},
            "decisions_in_force": {"type": "array", "items": {"type": "string"}},
            "known_deviations": {"type": "array", "items": {"type": "string"}},
            "requires_recheck": {"type": "array", "items": {"type": "string"}},
            "next_decision": {"type": "string"}
          }
        }
      }
    },
    "assurance": {
      "type": "object",
      "required": ["pilot_required", "pilot", "risk_acceptances"],
      "properties": {
        "pilot_required": {"type": "boolean"},
        "pilot": {
          "type": "object",
          "properties": {
            "status": {"enum": ["passed", "failed"]},
            "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "authorized_by": {"type": "string", "minLength": 1},
            "authority": {"type": "string", "minLength": 1},
            "executor_id": {"type": "string", "minLength": 1},
            "executed_at": {"type": "string", "minLength": 1},
            "scope": {"type": "string", "minLength": 1},
            "resource_cap": {"type": "string", "minLength": 1},
            "evidence": {"type": "array", "minItems": 1},
            "failures": {"type": "array"},
            "repairs": {"type": "array"}
          }
        },
        "risk_acceptances": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["finding_digest", "content_digest", "accepted_by", "authority", "accepted_at", "scope", "evidence"],
            "properties": {
              "finding_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "accepted_by": {"type": "string", "minLength": 1},
              "authority": {"type": "string", "minLength": 1},
              "accepted_at": {"type": "string", "minLength": 1},
              "scope": {"type": "string", "minLength": 1},
              "evidence": {"type": ["string", "array"]}
            }
          }
        }
      }
    },
    "reviews": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"workflow": {"properties": {"requested_mode": {"const": "full"}}}}},
      "then": {"properties": {"workflow": {"properties": {
        "artifact_level": {"const": "full"},
        "promotion": {"properties": {"status": {"const": "not-applicable"}}}
      }}}}
    },
    {
      "if": {"properties": {"workflow": {"properties": {"artifact_level": {"const": "brief"}}}}},
      "then": {"properties": {
        "campaign": {"required": ["starting_point"]},
        "workflow": {"allOf": [
        {
          "if": {"properties": {"requested_mode": {"const": "auto"}}},
          "then": {"properties": {"promotion": {"properties": {"status": {"enum": ["pending", "offered", "declined"]}}}}}
        },
        {
          "if": {"properties": {"requested_mode": {"const": "brief"}}},
          "then": {"properties": {"promotion": {"properties": {"status": {"const": "not-offered"}}}}}
        }
      ]}}}
    },
    {
      "if": {"properties": {"workflow": {"properties": {"artifact_level": {"const": "full"}}}}},
      "then": {"properties": {"campaign": {"required": [
        "starting_point", "constitution", "mission", "dossier", "inquiries", "methods",
        "tools", "canaries", "evaluation", "stages", "gates", "resources_dispatch",
        "roles", "runtime", "work_units", "ethics_rights_safety", "reporting", "claims",
        "deliverables", "kickoff"
      ]}}}
    },
    {
      "if": {"properties": {"workflow": {"allOf": [
        {"properties": {"requested_mode": {"enum": ["auto", "brief"]}}},
        {"properties": {"artifact_level": {"const": "full"}}}
      ]}}},
      "then": {"properties": {"workflow": {"properties": {
        "promotion": {"properties": {"status": {"const": "accepted"}}}
      }}}}
    }
  ]
}
