{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/rescamp/scenario.schema.json",
  "title": "ResCamp hidden benchmark scenario",
  "type": "object",
  "required": ["id", "title", "domain", "archetypes", "profile", "initial_request", "hidden_brief", "material_dimensions", "forbidden_assumptions", "required_campaign_features", "critical_defects"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "title": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "minLength": 1},
    "archetypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["experimental", "computational", "observational", "qualitative-field", "humanities-interpretive", "conceptual-normative", "evidence-synthesis", "policy-program-evaluation", "design-engineering", "creative-practice", "mixed-methods"]
      }
    },
    "profile": {"enum": ["scoped", "standard", "high-assurance"]},
    "initial_request": {"type": "string", "minLength": 1},
    "hidden_brief": {
      "type": "object",
      "required": ["facts", "knowledge_limits", "answer_policy"],
      "properties": {
        "facts": {"type": "object"},
        "knowledge_limits": {"type": "array", "items": {"type": "string"}},
        "answer_policy": {"type": "string", "minLength": 1},
        "evolution_rules": {"type": "array", "items": {"type": "object"}}
      }
    },
    "material_dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "branch", "importance", "expected_by_turn", "acceptable_resolution"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "branch": {"type": "string", "minLength": 1},
          "importance": {"enum": ["low", "material", "critical"]},
          "expected_by_turn": {"type": "integer", "minimum": 0},
          "acceptable_resolution": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "answer_key": {},
          "forces_blocker": {"type": "boolean"}
        }
      }
    },
    "forbidden_assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "severity"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "severity": {"enum": ["minor", "major", "critical"]}
        }
      }
    },
    "required_campaign_features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1}
        }
      }
    },
    "critical_defects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "severity"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "severity": {"enum": ["minor", "major", "critical"]}
        }
      }
    },
    "question_budget": {
      "type": "object",
      "required": ["soft", "hard"],
      "properties": {
        "soft": {"type": "integer", "minimum": 0},
        "hard": {"type": "integer", "minimum": 0}
      }
    }
  }
}
