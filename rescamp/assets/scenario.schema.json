{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/rescamp/scenario.schema.json",
  "title": "ResCamp hidden benchmark scenario",
  "type": "object",
  "required": ["id", "title", "domain", "archetypes", "profile", "initial_request", "hidden_brief", "material_dimensions", "forbidden_assumptions", "required_campaign_features", "critical_defects"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "title": {"type": "string"},
    "domain": {"type": "string"},
    "archetypes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "profile": {"enum": ["scoped", "standard", "high-assurance"]},
    "initial_request": {"type": "string", "minLength": 1},
    "hidden_brief": {
      "type": "object",
      "required": ["facts", "knowledge_limits", "answer_policy"],
      "properties": {
        "facts": {"type": "object"},
        "knowledge_limits": {"type": "array", "items": {"type": "string"}},
        "answer_policy": {"type": "string"},
        "evolution_rules": {"type": "array", "items": {"type": "object"}}
      }
    },
    "material_dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "importance", "expected_by_turn", "acceptable_resolution"],
        "properties": {
          "id": {"type": "string"},
          "importance": {"enum": ["low", "material", "critical"]},
          "expected_by_turn": {"type": "integer", "minimum": 0},
          "acceptable_resolution": {"type": "array", "items": {"type": "string"}},
          "answer_key": {}
        }
      }
    },
    "forbidden_assumptions": {"type": "array", "items": {"type": "object"}},
    "required_campaign_features": {"type": "array", "items": {"type": "object"}},
    "critical_defects": {"type": "array", "items": {"type": "object"}},
    "question_budget": {"type": "object"}
  }
}
